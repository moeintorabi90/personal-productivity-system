# Copy to apps/api/.env for local development. Never commit .env.

# HTTP port for the sync API.
PORT=8787

# Network interface. Default (unset): 127.0.0.1, reachable only from this computer.
# Setting a non-loopback value (0.0.0.0, ::, a LAN IP, or a host name) lets other devices connect;
# the server then refuses to start unless SETUP_TOKEN is set. Only do this on a trusted network
# and remember the API speaks plain HTTP: use HTTPS (a reverse proxy) for anything beyond testing.
# HOST=0.0.0.0

# Option A (default for this PC): embedded PGlite database.
# Default location when unset: %LOCALAPPDATA%\PersonalProductivitySystem\pglite-dev (outside the repo).
# It must be on an NTFS drive: PGlite fails on exFAT (drive E: on this PC). Relative paths resolve from apps/api.
# PGLITE_DATA_DIR=C:\path\on\ntfs\pglite-dev

# Option B: a real PostgreSQL server. When set, it takes precedence over PGLITE_DATA_DIR.
# DATABASE_URL=postgres://pps_dev:change-me@localhost:5432/pps_dev

# One-time secret required by POST /v1/setup (sent as the X-Setup-Token header).
# Required when NODE_ENV=production or when HOST is not loopback. Minimum 24 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SETUP_TOKEN=

# Optional: real PostgreSQL used by `npm test` instead of PGlite (each test file uses its own schema).
# TEST_DATABASE_URL=postgres://pps_test:change-me@localhost:5432/pps_test
