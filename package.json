{
  "name": "personal-productivity-system",
  "private": true,
  "version": "0.6.0",
  "description": "Offline-first personal planning and reflection app.",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev:api": "node --watch --import ./tools/node-aliases.mjs --env-file-if-exists=apps/api/.env apps/api/src/server.ts",
    "start:api": "node --import ./tools/node-aliases.mjs --env-file-if-exists=apps/api/.env apps/api/src/server.ts",
    "db:migrate": "node --import ./tools/node-aliases.mjs --env-file-if-exists=apps/api/.env apps/api/src/db/migrate-cli.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview:web": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p apps/web",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test --config apps/web/playwright.config.ts",
    "icons": "node tools/generate-icons.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.13",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
